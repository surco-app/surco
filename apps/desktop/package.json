{
  "name": "surco",
  "version": "1.9.0",
  "description": "Organizador de pistas de audio para DJ: convierte a AIFF lossless, etiqueta desde Discogs y manda a Apple Music",
  "main": "./out/main/index.js",
  "author": "Surco App",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --build && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "build-baken": "node ../../scripts/build-baken.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "check": "biome check --write src",
    "sweep": "vitest run src/main/spectrumSweep.test.ts",
    "sweep:library": "vitest run src/main/librarySweep.test.ts",
    "search-sweep": "vitest run src/main/searchSweep.test.ts",
    "bits-sweep": "vitest run src/main/bitsWindowSweep.test.ts",
    "corpus": "vitest run src/main/tagCorpus.test.ts",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "i18next": "^26.5.2",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "node-taglib-sharp": "^6.0.3",
    "sql.js": "^1.15.0"
  }
}
