+    /// rekordbox maps the stick's playlists by id in `playlists3.sync`: an id that moved
+    /// between exports is another playlist to it. The ids Surco gives are kept, and a
+    /// playlist new to the stick takes the next free one, in document order.
+    #[test]
+    fn device_ids_from_the_xml_are_kept() {
+        let ids = |nodes: &str| -> anyhow::Result<Vec<u32>> {
+            let lib = library(nodes);
+            let selected: Vec<usize> = (0..lib.playlists.len()).collect();
+            let model = build(&lib, &[], &selected, "USB", "2026-10-16", None)?;
+            Ok(model.playlists.iter().map(|p| p.id).collect())
+        };
+        let node = |name: &str, extra: &str| {
+            format!(r#"<NODE Type="1" Name="{name}" KeyType="0" Entries="0"{extra}/>"#)
+        };
+        let given = [node("A", ""), node("B", r#" DeviceId="9""#), node("C", "")].concat();
+        assert_eq!(ids(&given).unwrap(), [10, 9, 11]);
+        let none = [node("A", ""), node("B", ""), node("C", "")].concat();
+        assert_eq!(ids(&none).unwrap(), [1, 2, 3]);
+        let twice = [node("A", r#" DeviceId="4""#), node("B", r#" DeviceId="4""#)].concat();
+        assert!(ids(&twice).is_err());
+        // The last id there is: a playlist new to the stick has none left, which is an
+        // error rather than an id that wraps onto another playlist's.
+        let last = node("A", r#" DeviceId="4294967295""#);
+        assert_eq!(ids(&last).unwrap(), [u32::MAX]);
+        let full = [last, node("B", "")].concat();
+        assert!(ids(&full).is_err());
+    }
