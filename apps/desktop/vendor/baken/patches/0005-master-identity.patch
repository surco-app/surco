diff --git a/crates/baken-export/src/identity.rs b/crates/baken-export/src/identity.rs
new file mode 100644
index 0000000..ef630be
--- /dev/null
+++ b/crates/baken-export/src/identity.rs
@@ -0,0 +1,46 @@
+//! The rekordbox collection's identity, as a front-end reads it from rekordbox's own
+//! database (`master.db`). rekordbox 7.2.19 writes it onto every stick it exports and
+//! treats a stick without it as another library: the collection's DBID in each track row
+//! and in OneLibrary's content, its cloud property ID and its My Tags, and the size its
+//! database has for each file. Measured on rekordbox's own export of the same playlist
+//! (16-18/10/2026). Without it baken writes what an XML-only export has.
+
+use anyhow::Context;
+use serde::Deserialize;
+use std::collections::HashMap;
+use std::path::Path;
+
+#[derive(Debug, Clone, Default, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct MasterIdentity {
+    /// `djmdProperty.DBID`.
+    pub db_id: u32,
+    /// `djmdCloudProperty.ID` of the row OneLibrary's `property.myTagMasterDBID` names.
+    pub my_tag_master_db_id: u32,
+    /// `djmdMyTag`, for OneLibrary's `myTag`.
+    pub my_tags: Vec<MyTag>,
+    /// `djmdContent.FileSize` by XML TrackID.
+    pub file_sizes: HashMap<String, u64>,
+}
+
+/// A `myTag` row: `seq` is already 0-based, `parent` 0 for a column.
+#[derive(Debug, Clone, Default, Deserialize)]
+pub struct MyTag {
+    pub id: u32,
+    pub seq: u32,
+    pub name: String,
+    pub attribute: u32,
+    pub parent: u32,
+}
+
+impl MasterIdentity {
+    /// The size rekordbox's database has for TrackID `track_id`.
+    pub fn file_size(&self, track_id: u64) -> Option<u64> {
+        self.file_sizes.get(&track_id.to_string()).copied()
+    }
+}
+
+pub fn load(path: &Path) -> anyhow::Result<MasterIdentity> {
+    let data = std::fs::read(path).with_context(|| format!("reading {}", path.display()))?;
+    serde_json::from_slice(&data).with_context(|| format!("reading {}", path.display()))
+}
