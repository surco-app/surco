+//! `expressport --master-ids FILE`: the rekordbox collection's identity a front-end read
+//! from rekordbox's database, which makes the stick rekordbox's own.
+
+#![cfg(feature = "expressport")]
+
+use std::path::{Path, PathBuf};
+use std::process::{Command, Output};
+
+/// Half a second of 16-bit stereo silence.
+fn wav(path: &Path) {
+    let data = vec![0u8; 22050 * 4];
+    let mut b = b"RIFF".to_vec();
+    b.extend_from_slice(&(36 + data.len() as u32).to_le_bytes());
+    b.extend_from_slice(b"WAVEfmt ");
+    b.extend_from_slice(&16u32.to_le_bytes());
+    b.extend_from_slice(&1u16.to_le_bytes());
+    b.extend_from_slice(&2u16.to_le_bytes());
+    b.extend_from_slice(&44100u32.to_le_bytes());
+    b.extend_from_slice(&(44100u32 * 4).to_le_bytes());
+    b.extend_from_slice(&4u16.to_le_bytes());
+    b.extend_from_slice(&16u16.to_le_bytes());
+    b.extend_from_slice(b"data");
+    b.extend_from_slice(&(data.len() as u32).to_le_bytes());
+    b.extend_from_slice(&data);
+    std::fs::write(path, b).unwrap();
+}
+
+/// A collection of one track, TrackID 143097810, in playlist `P`.
+fn library(name: &str) -> PathBuf {
+    let root = std::env::temp_dir().join(format!("baken-master-ids-{name}-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&root);
+    for d in ["music", "usb", "anlz"] {
+        std::fs::create_dir_all(root.join(d)).unwrap();
+    }
+    wav(&root.join("music/t.wav"));
+    std::fs::write(
+        root.join("collection.xml"),
+        format!(
+            r#"<?xml version="1.0" encoding="UTF-8"?><DJ_PLAYLISTS Version="1.0.0"><COLLECTION Entries="1"><TRACK TrackID="143097810" Name="t" Artist="A" Album="B" Kind="WAV File" TotalTime="0" AverageBpm="120.00" SampleRate="44100" BitRate="1411" Location="file://localhost{}/music/t.wav"/></COLLECTION><PLAYLISTS><NODE Type="0" Name="ROOT" Count="1"><NODE Name="P" Type="1" KeyType="0" Entries="1"><TRACK Key="143097810"/></NODE></NODE></PLAYLISTS></DJ_PLAYLISTS>"#,
+            root.display()
+        ),
+    )
+    .unwrap();
+    root
+}
+
+fn expressport(root: &Path, master_ids: &Path) -> Output {
+    Command::new(env!("CARGO_BIN_EXE_baken"))
+        .env("BAKEN_NO_UPDATE_CHECK", "1")
+        .arg("expressport")
+        .arg(root.join("collection.xml"))
+        .arg("--device")
+        .arg(root.join("usb"))
+        .arg("--anlz-dir")
+        .arg(root.join("anlz"))
+        .args(["--no-settings", "--generate-analysis", "--json"])
+        .arg("--master-ids")
+        .arg(master_ids)
+        .output()
+        .unwrap()
+}
+
+/// The track row of export.pdb carries the identity: the XML TrackID at `+0x14` followed
+/// by the collection's DBID at `+0x18`.
+#[test]
+fn master_ids_is_read_from_a_file() {
+    let root = library("good");
+    let file = root.join("master-ids.json");
+    std::fs::write(
+        &file,
+        r#"{"dbId": 3942308644, "myTagMasterDbId": 4278116378,
+            "myTags": [{"id": 1, "seq": 0, "name": "Genre", "attribute": 1, "parent": 0}],
+            "fileSizes": {"143097810": 53680358}}"#,
+    )
+    .unwrap();
+    let out = expressport(&root, &file);
+    assert!(
+        out.status.success(),
+        "{}",
+        String::from_utf8_lossy(&out.stdout)
+    );
+    let pdb = std::fs::read(root.join("usb/PIONEER/rekordbox/export.pdb")).unwrap();
+    let ids = [
+        53680358u32.to_le_bytes(),
+        143097810u32.to_le_bytes(),
+        3942308644u32.to_le_bytes(),
+    ]
+    .concat();
+    assert!(
+        pdb.windows(ids.len()).any(|w| w == ids),
+        "file size, master id and DBID in a row"
+    );
+    std::fs::remove_dir_all(&root).unwrap();
+}
+
+/// Surco never writes a stick from a half-read identity: a file that does not parse ends
+/// the run before the plan, with the error line and a failing status, and the stick is
+/// left untouched.
+#[test]
+fn a_bad_master_ids_file_is_an_error_before_anything_is_written() {
+    let root = library("bad");
+    let file = root.join("master-ids.json");
+    std::fs::write(&file, r#"{"dbId": "#).unwrap();
+    let out = expressport(&root, &file);
+    assert!(!out.status.success());
+    let stdout = String::from_utf8(out.stdout).unwrap();
+    let lines: Vec<&str> = stdout.lines().collect();
+    assert_eq!(lines.len(), 1, "{stdout}");
+    let line: serde_json::Value = serde_json::from_str(lines[0]).unwrap();
+    assert_eq!(line["event"], "error", "{stdout}");
+    assert_eq!(line["kind"], "other", "{stdout}");
+    assert_eq!(std::fs::read_dir(root.join("usb")).unwrap().count(), 0);
+    std::fs::remove_dir_all(&root).unwrap();
+}
