diff --git a/crates/baken/src/expressport.rs b/crates/baken/src/expressport.rs
index 927204d..97bf19e 100644
--- a/crates/baken/src/expressport.rs
+++ b/crates/baken/src/expressport.rs
@@ -25,6 +25,7 @@ pub fn run(args: &ExpressportArgs) -> Result<()> {
         prune: args.prune,
