         }
     };
@@ -1504,6 +1536,15 @@ fn copy_audio(src: &Path, dst: &Path) -> anyhow::Result<u64> {
     copied
 }
 
+/// Give `dst` the modification time of `src`.
+fn keep_modified(src: &Path, dst: &Path) -> std::io::Result<()> {
+    let time = std::fs::metadata(src)?.modified()?;
+    std::fs::File::options()
+        .write(true)
+        .open(dst)?
+        .set_modified(time)
+}
