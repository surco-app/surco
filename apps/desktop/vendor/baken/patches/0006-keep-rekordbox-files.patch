diff --git a/crates/baken-export/tests/onelibrary.rs b/crates/baken-export/tests/onelibrary.rs
index 537c4ee..7017c72 100644
--- a/crates/baken-export/tests/onelibrary.rs
+++ b/crates/baken-export/tests/onelibrary.rs
@@ -204,3 +204,90 @@ fn a_stale_log_that_stays_keeps_the_database_off_the_stick() {
     assert_eq!(report.tracks_in_database, 1);
     std::fs::remove_dir_all(&root).unwrap();
 }
+
+/// With patch 0005's identity the stick is rekordbox's own library, and rekordbox expects
+/// to find the My Tag tables it wrote (`exportExt.pdb`) when it syncs it again. A stale
+/// write-ahead log still goes: it would replay into the new database.
+#[test]
+fn keep_rekordbox_ext_leaves_export_ext_pdb() {
+    for onelibrary in [true, false] {
+        let (root, mut opts) = rekordbox_stick(&format!("keep-ext-{onelibrary}"));
+        std::fs::write(rb(&opts).join("exportExt.pdb"), b"ext").unwrap();
+        opts.onelibrary = onelibrary;
+        opts.keep_rekordbox_ext = true;
+        let report = export(&plan(&opts).unwrap(), &(), &CancelToken::new()).unwrap();
+        assert!(report.failures.is_empty(), "{:?}", report.failures);
+        assert_eq!(
+            std::fs::read(rb(&opts).join("exportExt.pdb")).unwrap(),
+            b"ext"
+        );
+        assert!(!rb(&opts).join("exportLibrary.db-wal").exists());
+        assert!(!rb(&opts).join("exportLibrary.db-shm").exists());
+        let removed = if onelibrary { 2 } else { 3 };
+        assert_eq!(
+            report.onelibrary_removed, removed,
+            "onelibrary {onelibrary}"
+        );
+        std::fs::remove_dir_all(&root).unwrap();
+    }
+    let (root, opts) = rekordbox_stick("drop-ext");
+    export(&plan(&opts).unwrap(), &(), &CancelToken::new()).unwrap();
+    assert!(left(&opts).is_empty(), "without the option all of them go");
+    std::fs::remove_dir_all(&root).unwrap();
+}
+
+fn find(dir: &Path, name: &str) -> Option<PathBuf> {
+    std::fs::read_dir(dir).ok()?.flatten().find_map(|e| {
+        let p = e.path();
+        if p.is_dir() {
+            find(&p, name)
+        } else {
+            (p.file_name()? == name).then_some(p)
+        }
+    })
+}
+
+fn modified(path: &Path) -> std::time::SystemTime {
+    std::fs::metadata(path).unwrap().modified().unwrap()
+}
+
+fn set_modified(path: &Path, secs: u64) {
+    std::fs::File::options()
+        .write(true)
+        .open(path)
+        .unwrap()
+        .set_modified(std::time::UNIX_EPOCH + std::time::Duration::from_secs(secs))
+        .unwrap();
+}
+
+/// The audio rekordbox copies onto a stick keeps its source's modification time, and the
+/// coexistence run that rekordbox accepted reproduced it. A track already on the stick is
+/// not written again, so its date stays whatever it was.
+#[test]
+fn copied_audio_carries_the_source_modification_time() {
+    const JAN_25_NOON: u64 = 1769342400;
+    let (root, opts) = rekordbox_stick("mtime");
+    let source = root.join("music/t.wav");
+    set_modified(&source, JAN_25_NOON);
+    export(&plan(&opts).unwrap(), &(), &CancelToken::new()).unwrap();
+    let copy = find(&opts.device.join("Contents"), "t.wav").unwrap();
+    let apart = |a: std::time::SystemTime, b: std::time::SystemTime| {
+        a.duration_since(b)
+            .or_else(|_| b.duration_since(a))
+            .unwrap()
+    };
+    assert!(
+        apart(modified(&copy), modified(&source)) <= std::time::Duration::from_secs(2),
+        "within FAT's two seconds"
+    );
+
+    const FEB_1: u64 = 1769904000;
+    set_modified(&copy, FEB_1);
+    let report = export(&plan(&opts).unwrap(), &(), &CancelToken::new()).unwrap();
+    assert_eq!(report.kept, 1);
+    assert_eq!(
+        modified(&copy),
+        std::time::UNIX_EPOCH + std::time::Duration::from_secs(FEB_1)
+    );
+    std::fs::remove_dir_all(&root).unwrap();
+}
