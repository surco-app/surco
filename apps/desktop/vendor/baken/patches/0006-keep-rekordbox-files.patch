+/// [`ONELIBRARY_FILES`] an export removes: all of them, or all but `exportExt.pdb`
+/// with [`Options::keep_rekordbox_ext`].
+fn removable(keep_ext: bool) -> impl Iterator<Item = &'static str> {
+    ONELIBRARY_FILES
+        .into_iter()
+        .filter(move |&n| !(keep_ext && n == "exportExt.pdb"))
+}
