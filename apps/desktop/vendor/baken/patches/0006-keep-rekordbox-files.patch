-fn replace_onelibrary(rb_dir: &Path, db: &[u8], report: &mut Report) -> anyhow::Result<()> {
-    for name in ONELIBRARY_FILES.iter().filter(|&&n| n != onelibrary::FILE) {
+fn replace_onelibrary(
