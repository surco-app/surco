 /// does not pile up prepared tracks. Two workers already hide the decoding
@@ -1368,6 +1395,11 @@ fn write_track(
         (Audio::Source, _) => {
             let size = copy_audio(&pt.source, &dest)?;
             report.copied += 1;
+            // rekordbox's copies keep their source's date; a filesystem that refuses
+            // it costs the date only, never the track.
+            if keep_modified(&pt.source, &dest).is_err() {
+                report.dates_not_kept += 1;
+            }
